# 이 파일을 복사해 application-local.properties 로 저장한 뒤 실제 값을 넣으세요.
# application-local.properties 는 .gitignore 에 등록되어 있어 Git에 올라가지 않습니다.
# 실제 값은 팀 채널(비공개)로 공유받으세요.
spring.datasource.url=jdbc:mysql://DB주소:3306/onbank?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
spring.datasource.username=DB계정
spring.datasource.password=DB비밀번호

# 가상 OTP 시드 암호화 키 (팀 채널에서 공유받은 값. 팀원 모두 같은 값을 써야 함)
onbank.otp.seed-key=OTP키

# 메일 발송 (선택). 넣지 않으면 메일 내용이 콘솔에만 출력된다
# Gmail : 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 만든 앱 비밀번호 16자리 (공백 없이)
